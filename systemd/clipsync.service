[Unit]
Description=ClipSync - Tailscale Clipboard Sync Daemon
# The clipboard belongs to the graphical session: start with it (so
# WAYLAND_DISPLAY/DISPLAY are set) and stop with it.
PartOf=graphical-session.target
After=graphical-session.target tailscaled.service
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/clipsync daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
