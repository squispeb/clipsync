<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Per-user LaunchAgent: the daemon must run inside your login session to
  reach your pasteboard (a root LaunchDaemon can't).
  scripts/setup-mac.sh fills in __HOME__ and installs this to
  ~/Library/LaunchAgents/com.clipsync.daemon.plist.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.clipsync.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/clipsync</string>
        <string>daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/clipsync.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/clipsync.log</string>
</dict>
</plist>
